<UserControl x:Class="Lasteast.App.Views.CloneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Clone.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,14" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{ui:Tr Clone.Source}" Style="{StaticResource Text.Section}" />
                        <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Source}" AutomationProperties.Name="{ui:Tr Clone.Source}">
                            <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:DiskChoice}"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Outline}" Command="{Binding SwapCommand}" Margin="12,22,12,0" VerticalAlignment="Top"
                            AutomationProperties.Name="{ui:Tr Clone.Swap}" ToolTip="{ui:Tr Clone.Swap}">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8AB;" />
                    </Button>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{ui:Tr Clone.Destination}" Style="{StaticResource Text.Section}" />
                        <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Destination}" AutomationProperties.Name="{ui:Tr Clone.Destination}">
                            <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:DiskChoice}"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{ui:Tr Clone.DestinationNote}" Foreground="{DynamicResource Sev.High}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasPartitions, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Clone.Partitions}" Style="{StaticResource Text.Section}" />
                    <ItemsControl ItemsSource="{Binding Partitions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PartitionChoice}">
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Clone.Options}" Style="{StaticResource Text.Section}" />
                    <CheckBox IsChecked="{Binding UsedSpace}" Content="{ui:Tr Clone.UsedSpaceOption}" Margin="0,3" />
                    <CheckBox IsChecked="{Binding NewIdentifiers}" Content="{ui:Tr Clone.NewIdsOption}" Margin="0,3" />
                    <CheckBox IsChecked="{Binding Verify}" Content="{ui:Tr Clone.VerifyOption}" Margin="0,3" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Clone.Check}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IssueViewModel}">
                                <TextBlock x:Name="T" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource Sev.Recommended}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Sev.Critical}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Accent}" Command="{Binding AddCommand}" Content="{ui:Tr Clone.Add}" Padding="16,8" />
                <TextBlock Text="{ui:Tr Editor.QueueNote}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="480" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
