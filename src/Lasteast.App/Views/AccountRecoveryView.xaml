<UserControl x:Class="Lasteast.App.Views.AccountRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Acc.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,10" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{DynamicResource Brush.Brand.Orange}" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Acc.Policy}" TextWrapping="Wrap" />
                    <Button Style="{StaticResource Button.Outline}" Command="{Binding OpenBackupCommand}" Content="{ui:Tr Acc.BackupFirst}" Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Copied}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8" Visibility="{Binding HasCopied, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Scenarios}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AccountScenario}">
                        <Expander Margin="0,0,0,8" Header="{Binding Title}">
                            <StackPanel Margin="8,6,0,6">
                                <TextBlock Text="{Binding Steps}" TextWrapping="Wrap" />
                                <Button Style="{StaticResource Button.Outline}" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="10,4"
                                        Content="{Binding Link}" Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Link}"
                                        Visibility="{Binding Link, Converter={StaticResource BoolToVis}}" ToolTip="{ui:Tr Acc.CopyLink}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
