<UserControl x:Class="Lasteast.App.Views.DiskMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:views="clr-namespace:Lasteast.App.Views"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation"
             FlowDirection="LeftToRight">
    <!-- Disk maps are always drawn in physical order (offset 0 on the left), also in RTL languages,
         so the picture matches sector order and other tools. Text inside blocks still follows the UI language. -->
    <ItemsControl ItemsSource="{Binding Segments}" Focusable="False" Height="{Binding MapHeight, RelativeSource={RelativeSource AncestorType=views:DiskMapView}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <ui:ProportionalPanel MinItemWidth="72" Spacing="4" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="ui:ProportionalPanel.Weight" Value="{Binding Weight}" />
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:SegmentViewModel}">
                <Button Style="{StaticResource Button.Base}" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Command="{Binding SelectCommand, RelativeSource={RelativeSource AncestorType=views:DiskMapView}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding ToolTip}"
                        AutomationProperties.Name="{Binding ToolTip}">
                    <Border x:Name="Block" CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Border}"
                            Background="{DynamicResource Brush.Surface}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="6" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="5" />
                            </Grid.RowDefinitions>
                            <!-- colour strip identifies the file system / role -->
                            <Border Background="{Binding ColorKey, Converter={StaticResource SegmentBrush}}" CornerRadius="6,6,0,0" />
                            <!-- hatched body for unallocated space -->
                            <Border Grid.Row="1" Grid.RowSpan="2" Background="{Binding ColorKey, Converter={StaticResource SegmentBrush}}"
                                    Visibility="{Binding IsUnallocated, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Grid.Row="1" Margin="8,5,6,2" FlowDirection="{Binding DataContext.IsRightToLeft, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource RtlToFlow}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Margin="0,0,4,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Brand.Orange}"
                                               Visibility="{Binding IsCritical, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="{Binding FileSystemText}" Style="{StaticResource Text.Muted}" />
                                <TextBlock x:Name="PendingTag" Text="{ui:Tr Seg.Pending}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Brand.Orange}" Visibility="Collapsed" />
                            </StackPanel>
                            <!-- used-space bar -->
                            <Grid Grid.Row="2" Background="{DynamicResource Brush.Track}"
                                  Visibility="{Binding IsUnallocated, Converter={StaticResource InvBoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding UsedFraction, Converter={StaticResource FractionToStar}}" />
                                    <ColumnDefinition Width="{Binding UsedFraction, Converter={StaticResource FractionToStar}, ConverterParameter=rest}" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding ColorKey, Converter={StaticResource SegmentBrush}}" Opacity="0.85" />
                            </Grid>
                        </Grid>
                    </Border>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                        <Setter TargetName="Block" Property="BorderBrush" Value="{DynamicResource Brush.Brand.Orange}" />
                        <Setter TargetName="Block" Property="BorderThickness" Value="2" />
                        <Setter TargetName="PendingTag" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Block" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        <Setter TargetName="Block" Property="BorderThickness" Value="2.5" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
