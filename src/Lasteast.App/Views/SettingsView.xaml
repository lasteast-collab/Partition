<UserControl x:Class="Lasteast.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Settings.Appearance}" Style="{StaticResource Text.Section}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{ui:Tr Settings.Language}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  AutomationProperties.Name="{ui:Tr Settings.Language}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding NativeName}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="{ui:Tr Settings.Theme}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                  AutomationProperties.Name="{ui:Tr Settings.Theme}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="{ui:Tr Settings.Accent}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}"
                                  AutomationProperties.Name="{ui:Tr Settings.Accent}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AccentOption}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="14" Height="14" Margin="0,0,8,0" Fill="{Binding Hex}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Settings.Privacy}" Style="{StaticResource Text.Section}" />
                    <CheckBox IsChecked="{Binding MaskSerialNumbers}" Content="{ui:Tr Settings.MaskSerials}" />
                    <CheckBox IsChecked="{Binding AutoRefresh}" Content="{ui:Tr Settings.AutoRefresh}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{DynamicResource Brush.Brand.Orange}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Settings.Safety}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{ui:Tr Settings.PhysicalNote}" TextWrapping="Wrap" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,0,0,6" />
                    <CheckBox IsChecked="{Binding AllowPhysicalDisks}" Content="{ui:Tr Settings.AllowPhysical}" />
                    <TextBlock Text="{Binding BackupFolder}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Settings.License}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding LicenseText}" TextWrapping="Wrap" />
                    <TextBlock Text="{ui:Tr Settings.LicenseNote}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button Style="{StaticResource Button.Outline}" Command="{Binding LoadLicenseCommand}" Content="{ui:Tr Settings.LoadLicense}" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding PortableText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Settings.Assistant}" Style="{StaticResource Text.Section}" />
                    <CheckBox IsChecked="{Binding AssistantAiEnabled}" Content="{ui:Tr Settings.AiEnabled}" />
                    <TextBlock Text="{ui:Tr Settings.AiNote}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,6" />
                    <TextBlock Text="{ui:Tr Settings.AiEndpoint}" Style="{StaticResource Text.Muted}" />
                    <TextBox Text="{Binding AssistantAiEndpoint, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Input}" IsEnabled="{Binding AssistantAiEnabled}" AutomationProperties.Name="{ui:Tr Settings.AiEndpoint}" />
                    <TextBlock Text="{ui:Tr Settings.AiModel}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
                    <TextBox Text="{Binding AssistantAiModel, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Input}" IsEnabled="{Binding AssistantAiEnabled}" AutomationProperties.Name="{ui:Tr Settings.AiModel}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Settings.Monitoring}" Style="{StaticResource Text.Section}" />
                    <CheckBox IsChecked="{Binding MonitorEnabled}" Content="{ui:Tr Settings.MonitorEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{ui:Tr Settings.MonitorInterval}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding MonitorIntervals}" SelectedItem="{Binding MonitorIntervalMinutes}" MinWidth="80" AutomationProperties.Name="{ui:Tr Settings.MonitorInterval}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Mode=OneWay}" /><Run Text=" min" /></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{ui:Tr Settings.LowSpace}" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox ItemsSource="{Binding LowSpaceOptions}" SelectedItem="{Binding LowSpacePercent}" MinWidth="70" AutomationProperties.Name="{ui:Tr Settings.LowSpace}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Mode=OneWay}" /><Run Text=" %" /></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Settings.Logs}" Style="{StaticResource Text.Section}" />
                    <TextBox Text="{Binding LogDirectory, Mode=OneWay}" Style="{StaticResource Text.Selectable}" Margin="0,0,0,8" />
                    <Button Style="{StaticResource Button.Outline}" HorizontalAlignment="Left" Command="{Binding OpenLogFolderCommand}"
                            Content="{ui:Tr Settings.OpenLogs}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo-mark.png" Width="56" Height="56" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lasteast Partition" FontWeight="Bold" FontSize="15" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ui:Tr Settings.Version}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text=" " Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                        <TextBlock Text="{ui:Tr Settings.BuildNote}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
