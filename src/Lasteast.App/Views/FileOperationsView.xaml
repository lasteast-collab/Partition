<UserControl x:Class="Lasteast.App.Views.FileOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr FileOps.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,12" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding Volume}" MinWidth="300" AutomationProperties.Name="{ui:Tr Perf.Volume}">
                            <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:VolumeChoice}"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding AnalyzeCommand}" Content="{ui:Tr FileOps.Analyze}" Padding="12,6" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Blockers}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BlockerRow}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
