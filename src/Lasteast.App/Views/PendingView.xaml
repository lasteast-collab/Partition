<UserControl x:Class="Lasteast.App.Views.PendingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:views="clr-namespace:Lasteast.App.Views"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Pending.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,2,0,16" TextWrapping="Wrap" />

            <!-- Result of the last Apply -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Base}" Padding="6,2" VerticalAlignment="Top"
                            Command="{Binding DismissReportCommand}" AutomationProperties.Name="{ui:Tr Common.Dismiss}">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE711;" FontSize="12" />
                    </Button>
                    <TextBox Text="{Binding Report, Mode=OneWay}" FontWeight="SemiBold">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource Text.Selectable}">
                                <Setter Property="Foreground" Value="{DynamicResource Sev.Critical}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportOk}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Health.Healthy}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </DockPanel>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Padding="28" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/Assets/logo-mark.png" Width="84" Height="84" />
                    <TextBlock Text="{ui:Tr Pending.Empty}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" Margin="0,10,0,2" />
                    <TextBlock Text="{ui:Tr Pending.EmptyHint}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <!-- Operation list -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Outline}" Command="{Binding UndoCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7A7;" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="{ui:Tr Pending.Undo}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Outline}" Command="{Binding ClearCommand}" Content="{ui:Tr Pending.Clear}" />
                            </StackPanel>
                            <TextBlock Text="{ui:Tr Pending.Operations}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PendingItem}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Index}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Text="{ui:Tr Pending.DataLoss}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sev.Critical}"
                                                       Visibility="{Binding DestroysData, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Button.Base}" Padding="6,4" Command="{Binding RemoveCommand}"
                                                ToolTip="{ui:Tr Pending.Remove}" AutomationProperties.Name="{ui:Tr Pending.Remove}">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Before / after per disk -->
                <ItemsControl ItemsSource="{Binding Previews}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiskPreview}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" />
                                    <TextBlock Text="{Binding IdentityText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <TextBlock Text="{ui:Tr Pending.Before}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <views:DiskMapView DataContext="{Binding Before}" MapHeight="60" />
                                    <TextBlock Text="{ui:Tr Pending.After}" FontWeight="SemiBold" Margin="0,10,0,4" />
                                    <views:DiskMapView DataContext="{Binding After}" MapHeight="60" />
                                    <TextBlock Text="{Binding Summary}" Margin="0,10,0,4" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:IssueViewModel}">
                                                <TextBlock x:Name="T" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource Sev.Recommended}" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Sev.Critical}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Confirmation -->
                <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Brush.Brand.Orange}" BorderThickness="1.5">
                    <StackPanel>
                        <TextBlock Text="{ui:Tr Pending.ConfirmTitle}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{ui:Tr Pending.ConfirmBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding EstimateText}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding BackupAcknowledged}" Content="{ui:Tr Pending.Ack}" />
                        <TextBlock Text="{Binding ConfirmationPrompt}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Width="200"
                                 HorizontalAlignment="Left" FontFamily="{StaticResource Font.Mono}" FlowDirection="LeftToRight"
                                 AutomationProperties.Name="{Binding ConfirmationPrompt}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource Button.Accent}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Padding="18,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8FB;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{ui:Tr Pending.Apply}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding BlockReason}" Foreground="{DynamicResource Sev.High}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Margin="12,0,0,0" MaxWidth="560" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Progress of the running / last run -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Pending.Running}" Style="{StaticResource Text.Section}" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,10" Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Track}" BorderThickness="0" />
                    <ItemsControl ItemsSource="{Binding ProgressLines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProgressLine}">
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Style="{StaticResource Text.Muted}" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{ui:Tr Pending.DoNotClose}" Foreground="{DynamicResource Sev.High}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
