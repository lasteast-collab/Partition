<UserControl x:Class="Lasteast.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{ui:Tr Clean.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,14" />

                <Button Style="{StaticResource Button.Accent}" Command="{Binding ScanCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="{ui:Tr Clean.Scan}" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Report}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Health.Healthy}" />
                </Border>

                <ItemsControl ItemsSource="{Binding Targets}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CleanupTargetViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" VerticalAlignment="Top" Margin="0,2,10,0"
                                              AutomationProperties.Name="{Binding Name}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DisabledReason}" Foreground="{DynamicResource Sev.High}" FontSize="12"
                                                   Visibility="{Binding DisabledReason, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SizeText}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" />
                                        <Button Style="{StaticResource Button.Base}" Padding="4,2" HorizontalAlignment="Right" Content="{ui:Tr Clean.ShowFiles}"
                                                Command="{Binding DataContext.ShowFilesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Confirmation -->
                <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Brush.Brand.Orange}" BorderThickness="1.5" Margin="0,4,0,12"
                        Visibility="{Binding Scanned, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTotalText}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding UseRecycleBin}" Content="{ui:Tr Clean.UseRecycleBin}" />
                        <CheckBox IsChecked="{Binding Confirmed}" Content="{ui:Tr Clean.Confirm}" />
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding CleanCommand}" IsEnabled="{Binding CanClean}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Padding="16,8" Content="{ui:Tr Clean.Clean}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{ui:Tr Clean.Exclusions}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{ui:Tr Clean.ExclusionsHint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ExclusionsText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Input}" AcceptsReturn="True"
                                 MinHeight="70" TextWrapping="NoWrap" FontFamily="{StaticResource Font.Mono}" FlowDirection="LeftToRight"
                                 AutomationProperties.Name="{ui:Tr Clean.Exclusions}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- File preview -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{ui:Tr Clean.Preview}" Style="{StaticResource Text.Section}" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewTitle}" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding PreviewFiles}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Text}"
                         FontFamily="{StaticResource Font.Mono}" FontSize="11.5" FlowDirection="LeftToRight" VirtualizingPanel.IsVirtualizing="True" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
