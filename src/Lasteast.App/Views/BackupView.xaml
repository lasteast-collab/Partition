<UserControl x:Class="Lasteast.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Backup.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,12" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Backup.Sources}" Style="{StaticResource Text.Section}" />
                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BackupSourceViewModel}">
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Exists}" Content="{Binding Path}" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Button.Outline}" Command="{Binding AddFolderCommand}" Content="{ui:Tr Backup.AddFolder}" Padding="10,4" HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Rec.Destination}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding DestinationText}" TextWrapping="Wrap" />
                    <Button Style="{StaticResource Button.Outline}" Command="{Binding DestinationCommand}" Content="{ui:Tr An.Browse}" Padding="10,4" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    <CheckBox IsChecked="{Binding Verify}" Content="{ui:Tr Backup.Verify}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Accent}" Command="{Binding RunCommand}" Content="{ui:Tr Backup.Run}" Padding="16,8" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Outline}" Command="{Binding CancelCommand}" Content="{ui:Tr Editor.Cancel}" Padding="12,6"
                        Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
