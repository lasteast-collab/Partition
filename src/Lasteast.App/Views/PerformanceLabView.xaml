<UserControl x:Class="Lasteast.App.Views.PerformanceLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Perf.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,12" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Perf.BenchTitle}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{ui:Tr Perf.BenchHint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding Volume}" MinWidth="320" AutomationProperties.Name="{ui:Tr Perf.Volume}">
                            <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:VolumeChoice}"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding SizeMb}" Margin="8,0" MinWidth="90" AutomationProperties.Name="{ui:Tr Perf.Size}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Mode=OneWay}" /><Run Text=" MB" /></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding BenchmarkCommand}" Content="{ui:Tr Perf.Run}" Padding="14,6" />
                    </StackPanel>
                    <TextBlock Text="{Binding BenchText}" TextWrapping="Wrap" Margin="0,10,0,0" FontFamily="Consolas" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Perf.SurfaceTitle}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{ui:Tr Perf.SurfaceHint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Disk}" MinWidth="320" AutomationProperties.Name="{ui:Tr LostP.Disk}">
                            <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:DiskChoice}"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding SurfaceCommand}" Content="{ui:Tr Perf.SurfaceRun}" Padding="14,6" Margin="8,0" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding CancelCommand}" Content="{ui:Tr Editor.Cancel}" Padding="12,6"
                                Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SurfaceText}" TextWrapping="Wrap" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding SurfaceMap}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SurfaceCell}">
                                <Rectangle x:Name="R" Width="10" Height="10" Margin="1" Fill="{DynamicResource Health.Unknown}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Ok"><Setter TargetName="R" Property="Fill" Value="{DynamicResource Health.Healthy}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Slow"><Setter TargetName="R" Property="Fill" Value="{DynamicResource Health.Caution}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter TargetName="R" Property="Fill" Value="{DynamicResource Health.Critical}" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
