<UserControl x:Class="Lasteast.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:views="clr-namespace:Lasteast.App.Views"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,16,20">
            <StackPanel>
                <DockPanel Margin="0,0,10,16">
                    <!-- Signature feature: SCAN MY COMPUTER -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Accent}" Padding="20,10" VerticalAlignment="Center"
                            Command="{Binding DataContext.ScanMyComputerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE945;" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="{ui:Tr SF.ScanMyComputer}" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Text="{ui:Tr Dashboard.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Stat tiles -->
                <ItemsControl ItemsSource="{Binding Stats}" Focusable="False" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StatTile}">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Display}" FontSize="20" FontWeight="SemiBold"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Muted}"
                                               Visibility="{Binding Caption, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Findings (fact-based; nothing here performs an action) -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,16" Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{ui:Tr Dashboard.Findings}" Style="{StaticResource Text.Section}" />
                        <ItemsControl ItemsSource="{Binding Findings}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Pill}" Background="{Binding SeverityKind, Converter={StaticResource SeverityBrush}}"
                                                MinWidth="96" VerticalAlignment="Top" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding SeverityText}" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{ui:Tr Dashboard.Disks}" Style="{StaticResource Text.Section}" />

                <!-- Empty state -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="/Assets/logo-mark.png" Width="96" Height="96" Opacity="0.9" />
                        <TextBlock Text="{ui:Tr Dashboard.Empty}" HorizontalAlignment="Center" Margin="0,10,0,0" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{ui:Tr Dashboard.EmptyHint}" HorizontalAlignment="Center" Style="{StaticResource Text.Muted}" />
                    </StackPanel>
                </Border>

                <!-- Disk cards with graphical maps -->
                <ItemsControl ItemsSource="{Binding Disks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,12" Padding="14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding MediaGlyph}" FontSize="20"
                                                       HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Model}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <ItemsControl ItemsSource="{Binding Badges}" Focusable="False" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:Badge}">
                                                            <Border Style="{StaticResource Pill}" Background="{Binding Kind, Converter={StaticResource BadgeBrush}}">
                                                                <TextBlock Text="{Binding Text}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource Font.Display}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding HealthKind, Converter={StaticResource HealthBrush}}" />
                                                <TextBlock Text="{Binding HealthText}" Style="{StaticResource Text.Muted}" ToolTip="{ui:Tr Health.UnknownTooltip}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <views:DiskMapView SelectCommand="{Binding DataContext.SelectSegmentCommand, RelativeSource={RelativeSource AncestorType=views:DashboardView}}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{ui:Tr Prop.Used}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text=": " Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text="{Binding UsedText}" Style="{StaticResource Text.Muted}" Margin="0,0,16,0" />
                                        <TextBlock Text="{ui:Tr Prop.Free}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text=": " Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource Text.Muted}" Margin="0,0,16,0" />
                                        <TextBlock Text="{ui:Tr Prop.Unallocated}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text=": " Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text="{Binding UnallocatedText}" Style="{StaticResource Text.Muted}" />
                                    </StackPanel>

                                    <!-- Read problems are always shown, never hidden -->
                                    <ItemsControl ItemsSource="{Binding Notes}" Focusable="False" Margin="0,6,0,0"
                                                  Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Foreground="{DynamicResource Sev.Recommended}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding LayoutProblems}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Sev.Critical}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Legend -->
                <WrapPanel Margin="0,4,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="12" />
                            <Setter Property="Height" Value="12" />
                            <Setter Property="RadiusX" Value="3" />
                            <Setter Property="RadiusY" Value="3" />
                            <Setter Property="Margin" Value="0,0,5,0" />
                        </Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                            <Setter Property="Margin" Value="0,0,14,0" />
                        </Style>
                    </WrapPanel.Resources>
                    <Rectangle Fill="{DynamicResource Seg.NTFS}" /><TextBlock Text="NTFS" />
                    <Rectangle Fill="{DynamicResource Seg.FAT}" /><TextBlock Text="FAT/FAT32" />
                    <Rectangle Fill="{DynamicResource Seg.exFAT}" /><TextBlock Text="exFAT" />
                    <Rectangle Fill="{DynamicResource Seg.ReFS}" /><TextBlock Text="ReFS" />
                    <Rectangle Fill="{DynamicResource Seg.EFI}" /><TextBlock Text="{ui:Tr Role.EfiSystem}" />
                    <Rectangle Fill="{DynamicResource Seg.Recovery}" /><TextBlock Text="{ui:Tr Role.Recovery}" />
                    <Rectangle Fill="{DynamicResource Seg.MSR}" /><TextBlock Text="{ui:Tr Role.MicrosoftReserved}" />
                    <Rectangle Fill="{DynamicResource Seg.Unallocated}" Stroke="{DynamicResource Brush.Border}" /><TextBlock Text="{ui:Tr Seg.Unallocated}" />
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Brand.Orange}" Margin="0,0,5,0" />
                    <TextBlock Text="{ui:Tr Legend.Protected}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Details panel -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <DockPanel Margin="18,20">
                <TextBlock DockPanel.Dock="Top" Text="{ui:Tr Details.Title}" Style="{StaticResource Text.Section}" FontSize="16" />
                <TextBlock DockPanel.Dock="Top" Text="{ui:Tr Details.Hint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                           Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <!-- Actions for the selected segment (they only add to the pending queue) -->
                    <ItemsControl ItemsSource="{Binding Actions}" Focusable="False" Margin="0,4,0,8"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActionItem}">
                                <Button x:Name="Btn" Style="{StaticResource Button.Outline}" Margin="0,0,6,6" Padding="10,5"
                                        Command="{Binding Command}" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock x:Name="Lbl" Text="{Binding Title}" />
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                        <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource Sev.Critical}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Inline operation editor -->
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12" DataContext="{Binding Editor}"
                            Visibility="{Binding Converter={StaticResource BoolToVis}}" BorderBrush="{DynamicResource Brush.Accent}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="{Binding TargetText}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8" TextWrapping="Wrap" />

                            <StackPanel Visibility="{Binding ShowSize, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="{ui:Tr Editor.SizeGiB}" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding SizeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"
                                         AutomationProperties.Name="{ui:Tr Editor.SizeGiB}" />
                                <TextBlock Text="{Binding RangeText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowOffset, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="{ui:Tr Editor.NewStartMiB}" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"
                                         AutomationProperties.Name="{ui:Tr Editor.NewStartMiB}" />
                                <TextBlock Text="{Binding OffsetRangeText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="{ui:Tr Editor.MoveToStart}" Command="{Binding MoveToStartCommand}" Style="{StaticResource Button.Outline}" Margin="0,0,6,0" />
                                    <Button Content="{ui:Tr Editor.MoveToEnd}" Command="{Binding MoveToEndCommand}" Style="{StaticResource Button.Outline}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowFileSystem, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="{ui:Tr Prop.FileSystem}" Style="{StaticResource Text.Muted}" />
                                <ComboBox ItemsSource="{Binding FileSystemOptions}" SelectedItem="{Binding FileSystem}" MinWidth="0"
                                          AutomationProperties.Name="{ui:Tr Prop.FileSystem}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="{ui:Tr Prop.Label}" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"
                                         AutomationProperties.Name="{ui:Tr Prop.Label}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowLetter, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="{ui:Tr Editor.Letter}" Style="{StaticResource Text.Muted}" />
                                <ComboBox ItemsSource="{Binding LetterOptions}" SelectedItem="{Binding Letter}" MinWidth="0"
                                          AutomationProperties.Name="{ui:Tr Editor.Letter}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Issues}" Focusable="False" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:IssueViewModel}">
                                        <TextBlock x:Name="T" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource Sev.Recommended}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Sev.Critical}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{ui:Tr Editor.QueueNote}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Accent}" Command="{Binding AddCommand}" Content="{ui:Tr Editor.Add}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Button.Outline}" Command="{Binding CancelCommand}" Content="{ui:Tr Editor.Cancel}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding SelectedDetails}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PropertyRow}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" />
                                    <TextBox x:Name="Val" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource Text.Selectable}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Emphasize}" Value="True">
                                        <Setter TargetName="Val" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
