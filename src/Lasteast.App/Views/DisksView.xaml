<UserControl x:Class="Lasteast.App.Views.DisksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:views="clr-namespace:Lasteast.App.Views"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Disks.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" />
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}"
                 Style="{StaticResource ListBox.Cards}" ItemContainerStyle="{StaticResource ListBoxItem.Card}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                        </DockPanel>
                        <TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" />
                        <Grid Height="6" Margin="0,8,0,0" Background="{DynamicResource Brush.Track}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding UsedFraction, Converter={StaticResource FractionToStar}}" />
                                <ColumnDefinition Width="{Binding UsedFraction, Converter={StaticResource FractionToStar}, ConverterParameter=rest}" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Brush.Accent}" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        DataContext="{Binding SelectedDisk}" Visibility="{Binding Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{ui:Tr Disks.Layout}" Style="{StaticResource Text.Section}" />
                        <views:DiskMapView MapHeight="64" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{ui:Tr Disks.Properties}" Style="{StaticResource Text.Section}" />
                        <ItemsControl ItemsSource="{Binding Properties}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PropertyRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" FontSize="13" />
                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource Text.Selectable}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
