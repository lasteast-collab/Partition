<UserControl x:Class="Lasteast.App.Views.PartitionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <DockPanel Margin="24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Partitions.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" />
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{ui:Tr Col.Partition}" SortMemberPath="Partition" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:PartitionRow}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Fill="{Binding ColorKey, Converter={StaticResource SegmentBrush}}" />
                                    <TextBlock Text="{Binding Partition}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{ui:Tr Col.Disk}" Binding="{Binding Disk}" SortMemberPath="SortDisk" Width="80" />
                    <DataGridTextColumn Header="{ui:Tr Col.Label}" Binding="{Binding Label}" Width="*" />
                    <DataGridTextColumn Header="{ui:Tr Col.FileSystem}" Binding="{Binding FileSystem}" Width="100" />
                    <DataGridTextColumn Header="{ui:Tr Col.Capacity}" Binding="{Binding Capacity}" SortMemberPath="SortCapacity" Width="110" />
                    <DataGridTextColumn Header="{ui:Tr Col.Used}" Binding="{Binding Used}" Width="110" />
                    <DataGridTextColumn Header="{ui:Tr Col.Free}" Binding="{Binding Free}" Width="110" />
                    <DataGridTemplateColumn Header="%" SortMemberPath="UsedFraction" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:PartitionRow}">
                                <Grid Height="6" VerticalAlignment="Center" Background="{DynamicResource Brush.Track}"
                                      ToolTip="{Binding UsedPercent}"
                                      Visibility="{Binding IsUnallocated, Converter={StaticResource InvBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding UsedFraction, Converter={StaticResource FractionToStar}}" />
                                        <ColumnDefinition Width="{Binding UsedFraction, Converter={StaticResource FractionToStar}, ConverterParameter=rest}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource Brush.Accent}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{ui:Tr Col.Type}" Binding="{Binding Type}" Width="150" />
                    <DataGridTextColumn Header="{ui:Tr Col.Style}" Binding="{Binding Style}" Width="70" />
                    <DataGridTextColumn Header="{ui:Tr Col.Offset}" Binding="{Binding Offset}" SortMemberPath="SortOffset" Width="100" />
                    <DataGridTextColumn Header="{ui:Tr Col.Alignment}" Binding="{Binding Alignment}" Width="130" />
                    <DataGridTextColumn Header="{ui:Tr Col.Status}" Binding="{Binding Flags}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
