<UserControl x:Class="Lasteast.App.Views.BootRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Boot.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,6" />
            <TextBlock Text="{Binding FirmwareText}" Style="{StaticResource Text.Muted}" Margin="0,0,0,10" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Boot.BcdTitle}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{ui:Tr Boot.BcdHint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding LoadBcdCommand}" Content="{ui:Tr Boot.LoadBcd}" Padding="12,6" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding ExportBcdCommand}" Content="{ui:Tr Boot.ExportBcd}" Padding="12,6" />
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="{ui:Tr Boot.Timeout}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Width="60" AutomationProperties.Name="{ui:Tr Boot.Timeout}" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding SetTimeoutCommand}" Content="{ui:Tr Boot.Apply}" Padding="8,2" Margin="6,0,16,0" />
                        <TextBlock Text="{ui:Tr Boot.NewName}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Width="220" AutomationProperties.Name="{ui:Tr Boot.NewName}" />
                    </WrapPanel>
                    <TextBlock Text="{ui:Tr Boot.EditNote}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding BcdEntries}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BcdRow}">
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Description, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Type, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                                        <TextBlock Text="{Binding Identifier}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap"><Run Text="{Binding Device, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Path, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{ui:Tr Boot.IsDefault}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />
                                        <WrapPanel Margin="0,4,0,0" Visibility="{Binding IsBootEntry, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource Button.Outline}" Command="{Binding SetDefaultCommand}" Content="{ui:Tr Boot.SetDefault}" Padding="8,2" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource Button.Outline}" Command="{Binding MoveUpCommand}" Content="{ui:Tr Pending.MoveUp}" Padding="8,2" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource Button.Outline}" Command="{Binding MoveDownCommand}" Content="{ui:Tr Pending.MoveDown}" Padding="8,2" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource Button.Outline}" Command="{Binding RenameCommand}" Content="{ui:Tr Boot.Rename}" Padding="8,2" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Boot.EspTitle}" Style="{StaticResource Text.Section}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding ListEspCommand}" Content="{ui:Tr Boot.ListEsp}" Padding="12,6" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding BackupEspCommand}" Content="{ui:Tr Boot.BackupEsp}" Padding="12,6" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding CheckEspCommand}" Content="{ui:Tr Boot.CheckEsp}" Padding="12,6" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding RestoreEspCommand}" Content="{ui:Tr Boot.RestoreEsp}" Padding="12,6" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding EspFiles}" Focusable="False" MaxHeight="220">
                        <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate></ItemsControl.Template>
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Boot.RepairTitle}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{ui:Tr Boot.RepairHint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Style="{StaticResource Button.Outline}" Command="{Binding RepairCommand}" Content="{ui:Tr Boot.Repair}" Padding="12,6" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding EspReport}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasEspReport, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{ui:Tr Boot.MbrSection}" Style="{StaticResource Text.Section}" Margin="0,14,0,4" />
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding MbrDisks}" SelectedItem="{Binding MbrDisk}" MinWidth="260" Margin="0,0,6,6" AutomationProperties.Name="{ui:Tr LostP.Disk}">
                            <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:DiskChoice}"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding MbrBackups}" SelectedItem="{Binding MbrBackup}" MinWidth="260" Margin="0,0,6,6" AutomationProperties.Name="{ui:Tr Boot.MbrSource}">
                            <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:MbrBackupChoice}"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding RepairMbrCommand}" Content="{ui:Tr Boot.RepairMbr}" Padding="12,6" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Text="{ui:Tr Boot.WinReSection}" Style="{StaticResource Text.Section}" Margin="0,14,0,4" />
                    <WrapPanel>
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding LoadWinReCommand}" Content="{ui:Tr Boot.WinReCheck}" Padding="12,6" Margin="0,0,6,6" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding EnableWinReCommand}" Content="{ui:Tr Boot.WinReEnable}" Padding="12,6" Margin="0,0,6,6" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding DisableWinReCommand}" Content="{ui:Tr Boot.WinReDisable}" Padding="12,6" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding WinReText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Boot.TablesTitle}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{ui:Tr Boot.TablesHint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Backups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BackupRow}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Button.Outline}" Command="{Binding RestoreCommand}" Content="{ui:Tr Boot.RestoreTable}" Padding="10,4" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Rescue.Title}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{ui:Tr Rescue.Hint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding RescueStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding BuildIsoCommand}" Content="{ui:Tr Rescue.Build}" Padding="12,6" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding CancelBuildCommand}" Content="{ui:Tr Editor.Cancel}" Padding="12,6"
                                Visibility="{Binding Building, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding RescueLog}" Focusable="False" MaxHeight="220">
                        <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate></ItemsControl.Template>
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
