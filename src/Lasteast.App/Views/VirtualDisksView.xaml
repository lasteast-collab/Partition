<UserControl x:Class="Lasteast.App.Views.VirtualDisksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Vd.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,12" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Vd.Create}" Style="{StaticResource Text.Section}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{ui:Tr Editor.SizeGiB}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SizeGb, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Width="90" AutomationProperties.Name="{ui:Tr Editor.SizeGiB}" />
                        <CheckBox IsChecked="{Binding Dynamic}" Content="{ui:Tr Vd.Dynamic}" VerticalAlignment="Center" Margin="12,0" />
                        <CheckBox IsChecked="{Binding InitializeGpt}" Content="{ui:Tr Vd.Init}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding CreateCommand}" Content="{ui:Tr Vd.CreateButton}" Padding="12,6" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding AttachCommand}" Content="{ui:Tr Vd.AttachButton}" Padding="12,6" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Vd.Attached}" Style="{StaticResource Text.Section}" />
                    <ItemsControl ItemsSource="{Binding Attached}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VirtualDiskRow}">
                                <DockPanel Margin="0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Outline}" Command="{Binding DetachCommand}" Content="{ui:Tr Vd.Detach}" Padding="10,4" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FileText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
