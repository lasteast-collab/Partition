<UserControl x:Class="Lasteast.App.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Asst.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,12" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Asst.Ask}" Style="{StaticResource Text.Section}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Outline}" Command="{Binding AskAiCommand}" Content="{ui:Tr Asst.AskAi}" Padding="12,6" Margin="6,0,0,0"
                                Visibility="{Binding AiAvailable, Converter={StaticResource BoolToVis}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Accent}" Command="{Binding SuggestCommand}" Content="{ui:Tr Asst.Suggest}" Padding="12,6" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Request, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" AutomationProperties.Name="{ui:Tr Asst.Ask}" />
                    </DockPanel>
                    <TextBlock Text="{ui:Tr Asst.Or}" Style="{StaticResource Text.Muted}" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding Goals}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GoalChoice}">
                                <Button Style="{StaticResource Button.Outline}" Command="{Binding Command}" Content="{Binding Title}" Padding="10,5" Margin="0,0,6,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Asst.Plan}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding PlanSteps}" Focusable="False" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IssueViewModel}">
                                <TextBlock x:Name="T" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource Sev.Recommended}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Sev.Critical}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding QueueCommand}" Content="{ui:Tr Asst.Queue}" Padding="12,6" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding OpenPageCommand}" Content="{ui:Tr Asst.Open}" Padding="12,6" />
                    </StackPanel>
                    <TextBlock Text="{ui:Tr Asst.Note}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
