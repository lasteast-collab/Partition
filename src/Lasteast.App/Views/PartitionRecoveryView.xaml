<UserControl x:Class="Lasteast.App.Views.PartitionRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr LostP.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,14" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr LostP.Disk}" Style="{StaticResource Text.Section}" />
                    <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Disk}" AutomationProperties.Name="{ui:Tr LostP.Disk}">
                        <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:DiskChoice}"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox IsChecked="{Binding DeepScan}" Content="{ui:Tr LostP.Deep}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding ScanCommand}" Content="{ui:Tr LostP.Scan}" Padding="16,6" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding CancelCommand}" Content="{ui:Tr Editor.Cancel}" Padding="12,6"
                                Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Found}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FoundPartitionViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.Outline}" Command="{Binding BrowseCommand}" Content="{ui:Tr LostP.Browse}" Padding="10,4" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource Button.Accent}" Command="{Binding RecoverCommand}" Content="{ui:Tr LostP.Restore}" Padding="10,4" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{ui:Tr LostP.Note}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
