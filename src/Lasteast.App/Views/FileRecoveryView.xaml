<UserControl x:Class="Lasteast.App.Views.FileRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Rec.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,12" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{ui:Tr Rec.Source}" Style="{StaticResource Text.Section}" />
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" AutomationProperties.Name="{ui:Tr Rec.Source}">
                    <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:RecoverySource}"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox IsChecked="{Binding IncludeExisting}" Content="{ui:Tr Rec.IncludeExisting}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox IsChecked="{Binding ByContent}" Content="{ui:Tr Rec.ByContent}" ToolTip="{ui:Tr Rec.ByContentHint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource Button.Accent}" Command="{Binding ScanCommand}" Content="{ui:Tr Rec.Scan}" Padding="14,6" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Outline}" Command="{Binding CancelCommand}" Content="{ui:Tr Editor.Cancel}" Padding="12,6"
                            Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,8">
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Width="260" AutomationProperties.Name="{ui:Tr Rec.Filter}" ToolTip="{ui:Tr Rec.Filter}" />
                    <Button Style="{StaticResource Button.Outline}" Command="{Binding SelectAllCommand}" Content="{ui:Tr Rec.SelectAll}" Padding="10,4" Margin="8,0,4,0" />
                    <Button Style="{StaticResource Button.Outline}" Command="{Binding SelectNoneCommand}" Content="{ui:Tr Rec.SelectNone}" Padding="10,4" />
                </StackPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding Files}" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="{ui:Tr Rec.Files}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:RecoverableFileViewModel}">
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanRecover}" AutomationProperties.Name="{Binding Path}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{ui:Tr An.Col.Name}" Width="420" DisplayMemberBinding="{Binding Path}" />
                            <GridViewColumn Header="{ui:Tr Col.Capacity}" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="{ui:Tr An.Col.Modified}" Width="140" DisplayMemberBinding="{Binding DateText}" />
                            <GridViewColumn Header="{ui:Tr Rec.Col.State}" Width="170" DisplayMemberBinding="{Binding StatusText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{ui:Tr Rec.Destination}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding DestinationText}" TextWrapping="Wrap" />
                    <TextBlock Text="{ui:Tr Rec.DestinationNote}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Outline}" Command="{Binding BrowseDestinationCommand}" Content="{ui:Tr An.Browse}" Padding="10,6" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Accent}" Command="{Binding RecoverCommand}" Content="{ui:Tr Rec.Recover}" Padding="16,6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
