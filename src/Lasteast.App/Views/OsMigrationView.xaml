<UserControl x:Class="Lasteast.App.Views.OsMigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
             xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{ui:Tr Mig.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,14" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Mig.Source}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding SourceText}" Margin="0,0,0,10" />
                    <TextBlock Text="{ui:Tr Mig.Destination}" Style="{StaticResource Text.Section}" />
                    <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Destination}" AutomationProperties.Name="{ui:Tr Mig.Destination}">
                        <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:DiskChoice}"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{ui:Tr Clone.DestinationNote}" Foreground="{DynamicResource Sev.High}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Mig.Usage}" Style="{StaticResource Text.Section}" />
                    <RadioButton IsChecked="{Binding ReplaceOldDisk}" GroupName="mig" Margin="0,3">
                        <StackPanel>
                            <TextBlock Text="{ui:Tr Mig.Replace}" FontWeight="SemiBold" />
                            <TextBlock Text="{ui:Tr Mig.ReplaceHint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding KeepBoth}" GroupName="mig" Margin="0,3">
                        <StackPanel>
                            <TextBlock Text="{ui:Tr Mig.KeepBoth}" FontWeight="SemiBold" />
                            <TextBlock Text="{ui:Tr Mig.KeepBothHint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Mig.Plan}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding FitText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SystemPartitions}" Focusable="False" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="8,1" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IssueViewModel}">
                                <TextBlock x:Name="T" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource Sev.Recommended}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Sev.Critical}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Button.Outline}" Command="{Binding QueuePreparationCommand}" Content="{ui:Tr Mig.QueuePrep}" Padding="14,6" Margin="0,0,8,0"
                                Visibility="{Binding NeedsPreparation, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding QueueMigrationCommand}" Content="{ui:Tr Mig.QueueMigration}" Padding="14,6" />
                    </StackPanel>
                    <TextBlock Text="{ui:Tr Mig.PrepNote}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding NeedsPreparation, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Mig.NextTitle}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding NextStepsText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr Mig.TroubleTitle}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{ui:Tr Mig.Trouble}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
