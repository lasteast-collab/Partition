<Window x:Class="Lasteast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lasteast.App.Infrastructure"
        xmlns:views="clr-namespace:Lasteast.App.Views"
        xmlns:vm="clr-namespace:Lasteast.Presentation.ViewModels;assembly=Lasteast.Presentation"
        Title="Lasteast Partition"
        Icon="Assets/app.ico"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FlowDirection="{Binding IsRightToLeft, Converter={StaticResource RtlToFlow}}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisksPageViewModel}"><views:DisksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PartitionsPageViewModel}"><views:PartitionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlannedModuleViewModel}"><views:PlannedView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PendingPageViewModel}"><views:PendingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SmartFixPageViewModel}"><views:SmartFixView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageAnalyzerViewModel}"><views:AnalyzerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupPageViewModel}"><views:CleanupView /></DataTemplate>

        <!-- Sidebar item -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <Button Style="{StaticResource Button.Nav}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}">
                <Button.Tag>
                    <MultiBinding Converter="{StaticResource RefEquals}">
                        <Binding />
                        <Binding Path="DataContext.SelectedNav" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Button.Tag>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="6,0,0,0" Padding="6,1"
                            Background="{DynamicResource Brush.Track}"
                            Visibility="{Binding IsPlanned, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PhaseBadge}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ================= Top bar ================= -->
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo-mark.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Lasteast" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="PARTITION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.TopNav}" Content="{ui:Tr Top.Home}" Command="{Binding NavigateCommand}" CommandParameter="{Binding TopTargets[0]}" />
                    <Button Style="{StaticResource Button.TopNav}" Content="{ui:Tr Top.DiskManagement}" Command="{Binding NavigateCommand}" CommandParameter="{Binding TopTargets[1]}" />
                    <Button Style="{StaticResource Button.TopNav}" Content="{ui:Tr Top.PartitionRecovery}" Command="{Binding NavigateCommand}" CommandParameter="{Binding TopTargets[2]}" />
                    <Button Style="{StaticResource Button.TopNav}" Content="{ui:Tr Top.Migration}" Command="{Binding NavigateCommand}" CommandParameter="{Binding TopTargets[3]}" />
                    <Button Style="{StaticResource Button.TopNav}" Content="{ui:Tr Top.Tools}" Command="{Binding NavigateCommand}" CommandParameter="{Binding TopTargets[4]}" />
                    <Button Style="{StaticResource Button.TopNav}" Content="{ui:Tr Top.Settings}" Command="{Binding NavigateCommand}" CommandParameter="{Binding TopTargets[5]}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pending operations: opens the preview / confirmation page -->
                    <Button Style="{StaticResource Button.Outline}" Margin="0,0,8,0" Command="{Binding OpenPendingCommand}"
                            ToolTipService.ShowOnDisabled="True" ToolTip="{ui:Tr Top.QueueTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8FB;" Margin="0,0,6,0" FontSize="14" />
                            <TextBlock Text="{Binding ApplyText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Outline}" Margin="0,0,8,0" Command="{Binding RestartElevatedCommand}"
                            Visibility="{Binding IsElevated, Converter={StaticResource InvBoolToVis}}"
                            ToolTip="{ui:Tr Top.ElevateTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7EF;" Margin="0,0,6,0" FontSize="14"
                                       Foreground="{DynamicResource Brush.Brand.Orange}" />
                            <TextBlock Text="{ui:Tr Top.RunAsAdmin}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Accent}" Command="{Binding RefreshCommand}" ToolTip="F5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" Margin="0,0,6,0" FontSize="14" />
                            <TextBlock Text="{ui:Tr Top.Refresh}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Banners ================= -->
        <StackPanel Grid.Row="1">
            <Border Background="{DynamicResource Brush.SampleBg}" Padding="16,8"
                    Visibility="{Binding IsSampleData, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Brush.SampleFg}" Margin="0,0,8,0" />
                    <TextBlock Text="{ui:Tr Banner.SampleData}" Foreground="{DynamicResource Brush.SampleFg}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.ErrorBg}" Padding="16,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Base}" Padding="6,2" Command="{Binding DismissErrorCommand}"
                            AutomationProperties.Name="{ui:Tr Common.Dismiss}">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE711;" FontSize="12" Foreground="{DynamicResource Brush.ErrorFg}" />
                    </Button>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Brush.ErrorFg}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,12">
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding SettingsNav}" ContentTemplate="{StaticResource NavItemTemplate}"
                                    Focusable="False" Margin="0,8,0,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NavGroups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavGroup}">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Margin="10,4,0,4"
                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NavItemTemplate}" Focusable="False" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Page host -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
                <!-- Busy overlay (scan in progress) -->
                <Border Background="#66000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar IsIndeterminate="True" Width="120" Height="4" Margin="0,0,14,0"
                                         Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Track}" BorderThickness="0" />
                            <TextBlock Text="{ui:Tr Status.Scanning}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72E;" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding PrivilegeText}" Style="{StaticResource Text.Muted}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="  ·  " Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{ui:Tr Status.QueueMode}" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
