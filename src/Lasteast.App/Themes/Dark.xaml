    <SolidColorBrush x:Key="Seg.Managed" Color="#EC4899" />
    <SolidColorBrush x:Key="Seg.Other" Color="#78909C" />
    <LinearGradientBrush x:Key="Seg.Unallocated" StartPoint="0,0" EndPoint="8,8" MappingMode="Absolute" SpreadMethod="Repeat">
        <GradientStop Color="#2B323C" Offset="0" />
        <GradientStop Color="#2B323C" Offset="0.5" />
        <GradientStop Color="#20262E" Offset="0.5" />
        <GradientStop Color="#20262E" Offset="1" />
    </LinearGradientBrush>
