    <SolidColorBrush x:Key="Brush.Surface" Color="#1C2128" />
    <SolidColorBrush x:Key="Brush.Card" Color="#222831" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="#2A313B" />
    <SolidColorBrush x:Key="Brush.Border" Color="#323A45" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E8ECF1" />
