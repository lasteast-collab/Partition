<!-- Generated palette. Accent brushes are injected at runtime by ThemeService. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Window" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#ECEFF3" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="#F4F7FB" />
    <SolidColorBrush x:Key="Brush.Border" Color="#D9DEE5" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1B2430" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#5B6675" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#E6EBF1" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#DCE3EB" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Track" Color="#E1E6EC" />
    <SolidColorBrush x:Key="Seg.NTFS" Color="#2563EB" />
    <SolidColorBrush x:Key="Seg.FAT" Color="#16A34A" />
    <SolidColorBrush x:Key="Seg.exFAT" Color="#0D9488" />
    <SolidColorBrush x:Key="Seg.ReFS" Color="#9333EA" />
    <SolidColorBrush x:Key="Seg.EFI" Color="#D97706" />
    <SolidColorBrush x:Key="Seg.MSR" Color="#64748B" />
    <SolidColorBrush x:Key="Seg.Recovery" Color="#EA580C" />
    <SolidColorBrush x:Key="Seg.Foreign" Color="#64748B" />
    <SolidColorBrush x:Key="Seg.Managed" Color="#DB2777" />
    <SolidColorBrush x:Key="Seg.Other" Color="#607D8B" />
    <LinearGradientBrush x:Key="Seg.Unallocated" StartPoint="0,0" EndPoint="8,8" MappingMode="Absolute" SpreadMethod="Repeat">
        <GradientStop Color="#E3E7EC" Offset="0" />
        <GradientStop Color="#E3E7EC" Offset="0.5" />
        <GradientStop Color="#F3F5F8" Offset="0.5" />
        <GradientStop Color="#F3F5F8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Sev.Critical" Color="#DC2626" />
    <SolidColorBrush x:Key="Sev.High" Color="#EA580C" />
    <SolidColorBrush x:Key="Sev.Recommended" Color="#CA8A04" />
    <SolidColorBrush x:Key="Sev.Optional" Color="#0284C7" />
    <SolidColorBrush x:Key="Sev.Info" Color="#64748B" />
    <SolidColorBrush x:Key="Sev.Healthy" Color="#16A34A" />
    <SolidColorBrush x:Key="Badge.Windows" Color="#2563EB" />
    <SolidColorBrush x:Key="Badge.Boot" Color="#D97706" />
    <SolidColorBrush x:Key="Badge.Removable" Color="#0D9488" />
    <SolidColorBrush x:Key="Badge.Virtual" Color="#9333EA" />
    <SolidColorBrush x:Key="Badge.Dynamic" Color="#DB2777" />
    <SolidColorBrush x:Key="Badge.Problem" Color="#DC2626" />
    <SolidColorBrush x:Key="Health.Unknown" Color="#64748B" />
    <SolidColorBrush x:Key="Health.Healthy" Color="#16A34A" />
    <SolidColorBrush x:Key="Health.Caution" Color="#CA8A04" />
    <SolidColorBrush x:Key="Health.Warning" Color="#EA580C" />
    <SolidColorBrush x:Key="Health.Critical" Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.SampleBg" Color="#FFF1D6" />
    <SolidColorBrush x:Key="Brush.SampleFg" Color="#7A4A00" />
    <SolidColorBrush x:Key="Brush.ErrorBg" Color="#FDE2E4" />
    <SolidColorBrush x:Key="Brush.ErrorFg" Color="#8A1622" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1B2430" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1B2430" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#1B2430" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#DCE3EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B2430" />
    <SolidColorBrush x:Key="Tm.Folder" Color="#93B4E6" />
    <SolidColorBrush x:Key="Tm.Videos" Color="#FB923C" />
    <SolidColorBrush x:Key="Tm.Images" Color="#34D399" />
    <SolidColorBrush x:Key="Tm.Audio" Color="#A78BFA" />
    <SolidColorBrush x:Key="Tm.Documents" Color="#60A5FA" />
    <SolidColorBrush x:Key="Tm.Archives" Color="#FBBF24" />
    <SolidColorBrush x:Key="Tm.Applications" Color="#94A3B8" />
    <SolidColorBrush x:Key="Tm.Games" Color="#F472B6" />
    <SolidColorBrush x:Key="Tm.Temporary" Color="#FDE047" />
    <SolidColorBrush x:Key="Tm.System" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Tm.Other" Color="#D1D5DB" />
</ResourceDictionary>
